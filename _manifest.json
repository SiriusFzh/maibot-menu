{
  "manifest_version": 2,
  "id": "maibot.menu",
  "version": "1.0.1",
  "plugin_type": "tool",
  "name": "菜单插件",
  "description": "发送 /菜单 生成菜单图片，展示手动配置的功能分组和指令，渲染失败时降级为文本。",
  "author": {
    "name": "SiriusFzh",
    "url": "https://github.com/SiriusFzh"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/SiriusFzh/maibot-menu",
    "homepage": "https://github.com/SiriusFzh/maibot-menu"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.image",
    "send.text",
    "render.html2png"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
